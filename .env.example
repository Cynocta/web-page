# Public site URL used for canonical metadata, sitemap, robots and structured data.
# Must be the www host: cynocta.com redirects there, and a non-www value points
# every canonical, sitemap entry and JSON-LD URL at a redirect.
NEXT_PUBLIC_SITE_URL=https://www.cynocta.com

# Optional Google Search Console verification token.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Optional GA4 property override. Defaults to the production property when unset,
# so set this on preview deploys to keep their traffic out of the real reports.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
